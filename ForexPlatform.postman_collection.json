{
  "info": {
    "name": "ForexPlatform API",
    "description": "Collection complète pour tester l'API ForexPlatform depuis Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://127.0.0.1:8000", "type": "string"},
    {"key": "token", "value": "", "type": "string"}
  ],
  "item": [
    {
      "name": "0. SANTE DE L'API",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/health/",
            "description": "Vérifie que l'API et la base de données fonctionnent. Pas besoin de token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. AUTHENTIFICATION",
      "item": [
        {
          "name": "Login - Obtenir Token JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('token', pm.response.json().access);",
                  "    pm.environment.set('refresh_token', pm.response.json().refresh);",
                  "    console.log('Token sauvegardé !');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"WIB\",\n  \"password\": \"homeboY2026\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/token/",
            "description": "Se connecter et récupérer le JWT. Le token est automatiquement sauvegardé dans la variable d'environnement."
          }
        },
        {
          "name": "Rafraichir le Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/token/refresh/",
            "description": "Renouveler le token d'accès quand il expire (après 1h)."
          }
        }
      ]
    },
    {
      "name": "2. DEVISES",
      "item": [
        {
          "name": "Liste des 33 devises",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/currencies/",
            "description": "Retourne toutes les devises disponibles. Pas besoin de token."
          }
        }
      ]
    },
    {
      "name": "3. TAUX DE CHANGE",
      "item": [
        {
          "name": "Taux EUR/USD (temps réel)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/rates/EUR/USD/",
            "description": "Taux de change EUR vers USD récupéré en temps réel depuis la BCE."
          }
        },
        {
          "name": "Taux USD/JPY (temps réel)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/rates/USD/JPY/",
            "description": "Taux de change USD vers JPY en temps réel."
          }
        },
        {
          "name": "Taux GBP/EUR (temps réel)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/rates/GBP/EUR/",
            "description": "Taux de change GBP vers EUR en temps réel."
          }
        },
        {
          "name": "ERREUR - Devise inconnue",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/rates/EUR/XYZ/",
            "description": "Teste le cas d'erreur avec une devise inexistante. Doit retourner 404."
          }
        }
      ]
    },
    {
      "name": "4. CONVERSION",
      "item": [
        {
          "name": "Convertir 500 EUR en USD",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_currency\": \"EUR\",\n  \"to_currency\": \"USD\",\n  \"amount\": 500\n}"
            },
            "url": "{{base_url}}/api/v1/convert/",
            "description": "Convertit 500 euros en dollars avec spread business."
          }
        },
        {
          "name": "Convertir 1000 USD en GBP",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_currency\": \"USD\",\n  \"to_currency\": \"GBP\",\n  \"amount\": 1000\n}"
            },
            "url": "{{base_url}}/api/v1/convert/"
          }
        },
        {
          "name": "Convertir 250 EUR en JPY",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_currency\": \"EUR\",\n  \"to_currency\": \"JPY\",\n  \"amount\": 250\n}"
            },
            "url": "{{base_url}}/api/v1/convert/"
          }
        },
        {
          "name": "ERREUR - Montant négatif",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_currency\": \"EUR\",\n  \"to_currency\": \"USD\",\n  \"amount\": -50\n}"
            },
            "url": "{{base_url}}/api/v1/convert/",
            "description": "Doit retourner 400 Bad Request."
          }
        },
        {
          "name": "ERREUR - Champ manquant",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_currency\": \"EUR\",\n  \"amount\": 100\n}"
            },
            "url": "{{base_url}}/api/v1/convert/",
            "description": "Doit retourner 400 car to_currency est manquant."
          }
        },
        {
          "name": "ERREUR - Sans token (401)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_currency\": \"EUR\",\n  \"to_currency\": \"USD\",\n  \"amount\": 100\n}"
            },
            "url": "{{base_url}}/api/v1/convert/",
            "description": "Doit retourner 401 car pas de token."
          }
        }
      ]
    },
    {
      "name": "5. WALLETS",
      "item": [
        {
          "name": "Créer Wallet EUR",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"currency_code\": \"EUR\"\n}"},
            "url": "{{base_url}}/api/v1/wallets/"
          }
        },
        {
          "name": "Créer Wallet USD",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"currency_code\": \"USD\"\n}"},
            "url": "{{base_url}}/api/v1/wallets/"
          }
        },
        {
          "name": "Créer Wallet XAF",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"currency_code\": \"XAF\"\n}"},
            "url": "{{base_url}}/api/v1/wallets/"
          }
        },
        {
          "name": "Mes Wallets",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/wallets/"
          }
        },
        {
          "name": "Transactions Wallet EUR",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/wallets/EUR/transactions/"
          }
        }
      ]
    },
    {
      "name": "6. TRANSFERTS",
      "item": [
        {
          "name": "Créer un Transfert",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient_id\": 2,\n  \"source_currency\": \"EUR\",\n  \"destination_currency\": \"USD\",\n  \"amount\": 100\n}"
            },
            "url": "{{base_url}}/api/v1/transfers/create/",
            "description": "Transfère 100 EUR vers un autre utilisateur en USD."
          }
        },
        {
          "name": "Mes Transferts",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/transfers/"
          }
        }
      ]
    },
    {
      "name": "7. CLES API",
      "item": [
        {
          "name": "Créer Clé API (free)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Mon App Mobile\",\n  \"tier\": \"free\"\n}"},
            "url": "{{base_url}}/api/v1/api-keys/create/"
          }
        },
        {
          "name": "Créer Clé API (standard)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"App Partenaire\",\n  \"tier\": \"standard\"\n}"},
            "url": "{{base_url}}/api/v1/api-keys/create/"
          }
        },
        {
          "name": "Mes Clés API",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/api-keys/"
          }
        }
      ]
    }
  ]
}
